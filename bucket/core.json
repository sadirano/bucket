{
  "depends": ["7zip", "clink"],
  "version": "1.1.0",
  "description": "Noir Core Utility Scripts – Lightweight Windows batch scripts to enhance administrative tasks.",
  "homepage": "https://github.com/sadirano/core",
  "license": "MIT",
  "url": "https://github.com/sadirano/core/archive/refs/tags/v1.1.0.zip",
  "hash": "a1f6eb3f2d472ba08367cee332ab27cec5085be6eca2b7bb2c4baa033e35ab30",
  "extract_dir": "core-1.1.0",
  "bin": ["adm.cmd", "env.cmd", "h.cmd", "hosts.cmd", "mk.cmd", "restart.cmd"],
  "post_install": [
    "clink autorun install | Out-Null",
    "clink set clink.autostart \"C:\\Windows\\System32\\doskey.exe\" /macrofile=%userprofile%\\scoop\\apps\\core\\current\\doskey.mac | Out-Null",
    "clink set clink.logo none | Out-Null",
    "clink set autosuggest.inline true | Out-Null",
    "powershell -NoProfile -ExecutionPolicy Bypass -File \"$dir\\install\\setup.ps1\""
  ],
  "checkver": {
    "github": "https://github.com/sadirano/core"
  },
  "autoupdate": {
    "url": "https://github.com/sadirano/core/archive/refs/tags/v$version.zip",
    "extract_dir": "core-$version"
  }
}
